{
  "name": "url-downloader",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "electron": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win portable nsis",
    "pages": "node scripts/publish-pages.js",
    "dist:installer": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "main": "electron/main.js",
  "description": "Download videos, audio, torrents and files by URL",
  "author": "Nipuna",
  "build": {
    "appId": "com.local.urldownloader",
    "productName": "URL Downloader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "public/**",
      "build/icon.png",
      "package.json",
      "converter.js"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "URL-Downloader-portable-${version}.exe"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "URL Downloader",
      "artifactName": "URL-Downloader-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
